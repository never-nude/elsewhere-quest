# Copy this file to .env and fill it in. The .env file is gitignored —
# credentials and personal phone numbers must never be committed.

# From your Twilio Console dashboard (https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token

# A voice-capable Twilio number you own, in E.164 format
TWILIO_FROM_NUMBER=+15551234567

# The phone that should ring, in E.164 format (e.g. +13477551181)
WAKEUP_TO_NUMBER=+15557654321

# Local wall-clock time to call, 24-hour HH:MM
WAKEUP_TIME=07:00

# IANA timezone the wake-up time is interpreted in
WAKEUP_TIMEZONE=America/New_York

# Days to call: comma-separated mon,tue,wed,thu,fri,sat,sun — or "all"
WAKEUP_DAYS=mon,tue,wed,thu,fri

# What the call says when you answer
WAKEUP_MESSAGE=Good morning! This is your wake-up call. Time to get up.

# How many times the message repeats within one call
WAKEUP_SAY_LOOP=2

# If the call is busy, unanswered, or fails: how many extra attempts,
# and how long to wait between them
WAKEUP_RETRIES=2
WAKEUP_RETRY_DELAY_MINUTES=3
